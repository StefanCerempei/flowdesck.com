generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String    @id @default(uuid())
  name             String
  subscriptionPlan String    @default("FREE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  vehicles Vehicle[]
  reservations Reservation[]
  users            User[]
  contacts         Contact[]
  tasks            Task[]
  invoices         Invoice[] // Linia nouă
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("VIEWER") // Roluri: SUPER_ADMIN, ADMIN, VIEWER
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id             String    @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  company        String?
  status         String    @default("LEAD")
  notes          String?   @db.Text
  reservations Reservation[]
  @@unique([tenantId, id])
  potentialValue Float?
  source         String?
  tenantId       String
  tenant         Company   @relation(fields: [tenantId], references: [id])
  invoices       Invoice[] // Linia nouă pentru a lega facturile de contacte
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Task {
  id        String   @id @default(uuid())
  title     String
  priority  String   @default("Normal") // Normal, Urgent
  completed Boolean  @default(false)

  tenantId  String
  tenant    Company  @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    // Ex: "INV-2026-001"
  amount        Float     // Valoarea facturii în EUR
  status        String    @default("PENDING") // PENDING (în așteptare), PAID (plătită), OVERDUE (scadentă)
  dueDate       String?   // Data scadenței

  tenantId      String
  tenant        Company   @relation(fields: [tenantId], references: [id])

  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}
enum Transmission {
  MANUAL
  AUTOMATIC
}
enum ReservationStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model Vehicle {
  id                  String        @id @default(uuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  brand               String        @db.VarChar(80)
  model               String        @db.VarChar(80)
  licensePlate        String        @db.VarChar(32)
  category            String        @db.VarChar(40)
  transmission        Transmission
  dailyRate           Decimal       @db.Decimal(10, 2)
  status              VehicleStatus @default(AVAILABLE)
  insuranceExpiration DateTime?     @db.Date
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  reservations        Reservation[]

  @@unique([companyId, licensePlate])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@index([companyId, insuranceExpiration])
}
model Reservation {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  contactId   String
  contact     Contact           @relation(fields: [companyId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  status      ReservationStatus @default(CONFIRMED)
  agreedTotal Decimal           @db.Decimal(12, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([companyId, vehicleId, status, startDate, endDate])
  @@index([companyId, status, endDate])
  @@index([companyId, startDate])
  @@index([companyId, contactId])
}
// Add to existing Company: vehicles Vehicle[], reservations Reservation[]
// Add to existing Contact: reservations Reservation[], @@unique([tenantId, id])
