{
  "name": "crm-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/rental-domain.test.js test/ai.test.js test/insights.test.js",
    "test:integration": "node --test test/backend.test.js test/rentals.integration.test.js",
    "seed:rental-demo": "node scripts/seed-rental-demo.js",
    "ai:verify-live": "node scripts/verify-live-ai.js",
    "demo:capture": "node scripts/demo-scenario.js capture",
    "demo:restore": "node scripts/demo-scenario.js restore",
    "demo:access": "node scripts/demo-access.js",
    "demo:reset-password": "node scripts/demo-access.js --reset",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.9.0",
    "@prisma/config": "^7.10.1",
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0"
  }
}
